<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane style="-fx-background-image: url('noran/desktop/images/background.png');
                   -fx-background-size: cover;
                   -fx-background-position: center center;
                   -fx-background-repeat: no-repeat;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="noran.desktop.Controllers.ForgotPasswordController">

    <!-- Background -->
    <ImageView fitHeight="768.0" fitWidth="1366.0" pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@images/background.png" />
        </image>
    </ImageView>

    <!-- Modern Glass Card -->
    <VBox maxWidth="420" maxHeight="380" prefWidth="420" prefHeight="380" spacing="24"
          alignment="CENTER"
          style="-fx-background-color: rgba(255,255,255,0.9);
                 -fx-background-radius: 24;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 8);"
          nodeOrientation="RIGHT_TO_LEFT"
          StackPane.alignment="CENTER">

        <padding>
            <Insets top="35" right="45" bottom="35" left="45"/>
        </padding>

        <!-- Back Link -->
        <HBox alignment="TOP_LEFT" prefWidth="350">
            <Hyperlink text="⬅️ الرجوع" onAction="#onBackClicked"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-text-fill: #888; -fx-underline: false;" />
        </HBox>

        <!-- Icon + Title -->
        <Label text="🔓 نسيت كلمة المرور"
               style="-fx-font-family: 'Segoe UI', 'Poppins'; -fx-font-weight: 700;
                      -fx-font-size: 24; -fx-text-fill: #690000;" />
        
        <Label text="أدخل بريدك الإلكتروني لإرسال رمز التحقق"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #666;" />

        <!-- Email Field -->
        <GridPane hgap="10" vgap="12" nodeOrientation="RIGHT_TO_LEFT" alignment="CENTER">
            <Label text="📧 البريد الالكتروني"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 600;
                          -fx-font-size: 14; -fx-text-fill: #444;
                          -fx-alignment: CENTER-RIGHT;" GridPane.rowIndex="0" />

            <TextField fx:id="emailField" promptText="example@email.com"
                       GridPane.rowIndex="1"
                       prefWidth="320" prefHeight="42"
                       nodeOrientation="LEFT_TO_RIGHT"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14;
                              -fx-background-radius: 12;
                              -fx-background-color: #f5f5f5;
                              -fx-border-color: #ddd;
                              -fx-border-radius: 12;
                              -fx-padding: 10 15;" />
        </GridPane>

        <!-- Send Button with Gradient -->
        <Button fx:id="sendCodeButton" text="📤 إرسال الكود" onAction="#onSendCodeClicked"
                prefWidth="220" prefHeight="48"
                style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 700;
                       -fx-font-size: 16; -fx-background-color: linear-gradient(to bottom, #8B0000, #690000);
                       -fx-background-radius: 14; -fx-text-fill: white;
                       -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 3);" />
    </VBox>

    <!-- Logo -->
    <ImageView fitHeight="240.0" fitWidth="230.0"
               preserveRatio="true" pickOnBounds="true"
               StackPane.alignment="TOP_LEFT">
        <image>
            <Image url="@images/Logo.png" />
        </image>
        <StackPane.margin>
            <Insets top="-10" />
        </StackPane.margin>
    </ImageView>

</StackPane>

