<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns="http://javafx.com/javafx/17.0.12" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="noran.desktop.Controllers.ForgotPasswordController"
      stylesheets="@auth-styles.css"
      prefWidth="1200" prefHeight="700">

    <!-- ==================== LEFT BRAND PANEL ==================== -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="30" 
          style="-fx-background-color: linear-gradient(to bottom right, #a40000, #690000, #3d0000);"
          prefWidth="500">
        <padding>
            <Insets top="60" right="50" bottom="60" left="50"/>
        </padding>
        
        <!-- Decorative Background Circles -->
        <StackPane>
            <!-- Large circle top-right -->
            <Circle radius="180" fill="rgba(255,255,255,0.06)" 
                    translateX="200" translateY="-150"/>
            <!-- Medium circle bottom-left -->
            <Circle radius="120" fill="rgba(255,255,255,0.04)" 
                    translateX="-180" translateY="200"/>
            <!-- Gold accent circle -->
            <Circle radius="80" fill="rgba(212,175,55,0.12)" 
                    translateX="150" translateY="180"/>
            
            <!-- Content -->
            <VBox alignment="CENTER" spacing="25">
                <!-- Logo -->
                <ImageView fitHeight="180" fitWidth="180" preserveRatio="true" smooth="true">
                    <effect>
                        <DropShadow color="rgba(0,0,0,0.4)" radius="20" spread="0.1"/>
                    </effect>
                    <image>
                        <Image url="@images/white-logo.png"/>
                    </image>
                </ImageView>
                
                <!-- Brand Text -->
                <VBox alignment="CENTER" spacing="12">
                    <Label text="نظام النوران" 
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 36px; -fx-font-weight: 700; -fx-text-fill: white;">
                        <effect>
                            <DropShadow color="rgba(0,0,0,0.3)" radius="10"/>
                        </effect>
                    </Label>
                    <Label text="نظام إدارة الفواتير والشحنات"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-text-fill: rgba(255,255,255,0.85);"/>
                </VBox>
                
                <!-- Decorative Line -->
                <HBox alignment="CENTER" spacing="15">
                    <Rectangle width="40" height="3" fill="rgba(212,175,55,0.8)" arcWidth="3" arcHeight="3"/>
                    <Circle radius="4" fill="rgba(212,175,55,0.8)"/>
                    <Rectangle width="40" height="3" fill="rgba(212,175,55,0.8)" arcWidth="3" arcHeight="3"/>
                </HBox>
                
                <!-- Features List -->
                <VBox spacing="15" alignment="CENTER">
                    <padding>
                        <Insets top="20"/>
                    </padding>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="✓" style="-fx-text-fill: #D4AF37; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="إدارة الفواتير بكفاءة" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="✓" style="-fx-text-fill: #D4AF37; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="تتبع الشحنات لحظياً" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="✓" style="-fx-text-fill: #D4AF37; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label text="تقارير وإحصائيات شاملة" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </VBox>

    <!-- ==================== RIGHT FORM PANEL ==================== -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" 
          style="-fx-background-color: #f8f9fa;"
          prefWidth="700">
        
        <!-- Form Card -->
        <VBox alignment="CENTER" spacing="30" maxWidth="440"
              style="-fx-background-color: white; -fx-background-radius: 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 40, 0, 0, 12);">
            <padding>
                <Insets top="45" right="55" bottom="50" left="55"/>
            </padding>
            
            <!-- Back Button -->
            <HBox alignment="CENTER_RIGHT" prefWidth="330">
                <Button text="⬅ الرجوع" onAction="#onBackClicked"
                        style="-fx-background-color: rgba(0,0,0,0.05); -fx-background-radius: 10; -fx-text-fill: #666; -fx-font-size: 13px; -fx-padding: 8 16; -fx-cursor: hand;"/>
            </HBox>
            
            <!-- Header -->
            <VBox alignment="CENTER" spacing="12" nodeOrientation="RIGHT_TO_LEFT">
                <Label text="🔓" style="-fx-font-size: 52px;"/>
                <Label text="نسيت كلمة المرور؟" 
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;"/>
                <Label text="لا تقلق! أدخل بريدك الإلكتروني وسنرسل لك رمز التحقق"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #6c757d; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="320"/>
            </VBox>
            
            <!-- Email Field -->
            <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
                <Label text="البريد الإلكتروني" 
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #495057;"/>
                <HBox alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2;">
                    <Label text="📧" style="-fx-font-size: 16px; -fx-padding: 0 0 0 15;"/>
                    <TextField fx:id="emailField" 
                               promptText="example@email.com"
                               prefHeight="52" prefWidth="280"
                               nodeOrientation="LEFT_TO_RIGHT"
                               style="-fx-background-color: transparent; -fx-font-size: 15px; -fx-padding: 0 15 0 10; -fx-border-width: 0;"/>
                </HBox>
            </VBox>
            
            <!-- Send Code Button -->
            <Button fx:id="sendCodeButton" 
                    text="📤 إرسال رمز التحقق"
                    onAction="#onSendCodeClicked"
                    prefWidth="330" prefHeight="52"
                    style="-fx-background-color: linear-gradient(to bottom, #c41e1e, #a40000, #7a0000); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-family: 'Segoe UI'; -fx-font-size: 16px; -fx-font-weight: 700; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(164,0,0,0.4), 15, 0, 0, 5);">
            </Button>
            
            <!-- Back to Login -->
            <HBox alignment="CENTER" spacing="8" maxWidth="330">
                <Label text="تذكرت كلمة المرور؟" style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
                <Hyperlink text="تسجيل الدخول" onAction="#onBackClicked"
                           style="-fx-font-size: 13px; -fx-text-fill: #a40000; -fx-font-weight: 600; -fx-underline: false; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </VBox>
</HBox>
