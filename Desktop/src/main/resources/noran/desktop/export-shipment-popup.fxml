<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" 
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.ExportShipmentPopupController">
    <VBox alignment="CENTER" spacing="18" 
          style="-fx-background-color: white; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #e9ecef; -fx-border-width: 1; -fx-min-width: 440;">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <!-- Logo -->
        <ImageView fitHeight="60.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@images/Logo.png" /></image>
        </ImageView>

        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #690000;" text="تعديل شحنة التصدير" />

        <!-- Basic Info Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="📦 معلومات الشحنة الأساسية" />
            
            <HBox spacing="14" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رقم الشحنة" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="shipmentNumberField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رقم UCR" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="ucrNumberField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
            </HBox>

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="طريقة الشحن" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <ComboBox fx:id="shippingMethodCombo" nodeOrientation="RIGHT_TO_LEFT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 6 10; -fx-font-size: 14px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="بحري" />
                            <String fx:value="جوي" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </VBox>

        <!-- Destination Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="🌍 بيانات الوجهة" />

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="بلد الوصول" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <TextField fx:id="destinationCountryField" alignment="CENTER_RIGHT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="ميناء الوصول" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <TextField fx:id="destinationPortField" alignment="CENTER_RIGHT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
            </VBox>
        </VBox>

        <!-- Shipment Details Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="📋 تفاصيل الشحنة" />

            <HBox spacing="10" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="عدد الحاويات" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="containersCountField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="الوزن (كجم)" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="totalWeightField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="القيمة (ج.م)" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="valueInEGPField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Fees Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="💰 الرسوم والمصاريف" />

            <HBox spacing="14" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="إجمالي الرسوم" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="totalFeesField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="8" alignment="CENTER">
                    <Label text="حالة الدفع" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <CheckBox fx:id="feePaidCheckbox" text="تم الدفع" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Status Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="📊 حالة الشحنة" />

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="الحالة الحالية" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <ComboBox fx:id="statusCombo" nodeOrientation="RIGHT_TO_LEFT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 6 10; -fx-font-size: 14px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="التحقق من المستندات" />
                            <String fx:value="فحص الجهات الرقابية" />
                            <String fx:value="تم السداد" />
                            <String fx:value="تم التحميل" />
                            <String fx:value="في الطريق" />
                            <String fx:value="تم التسليم" />
                            <String fx:value="مكتمل" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="16" style="-fx-padding: 16 0 0 0;">
            <Button onAction="#cancel" prefWidth="130" prefHeight="46"
                style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-text-fill: #495057; -fx-font-size: 15px; -fx-font-weight: 600; -fx-cursor: hand;" 
                text="إلغاء" />
            <Button onAction="#save" prefWidth="130" prefHeight="46"
                style="-fx-background-color: linear-gradient(to bottom, #c41e1e, #a40000, #7a0000); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700; -fx-cursor: hand;" 
                text="حفظ التعديلات" />
        </HBox>

    </VBox>
</ScrollPane>
