<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ExportShipmentPopupController">
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: #f7f7f7; -fx-background-radius: 20; -fx-border-radius: 20;">

        <!-- Logo -->
        <ImageView fitHeight="80.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@images/Logo.png" /></image>
        </ImageView>

        <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="تعديل شحنة التصدير" />

        <!-- Basic Info Section -->
        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #690000;" text="معلومات الشحنة الأساسية" />

        <HBox spacing="15" alignment="CENTER">
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="رقم الشحنة" style="-fx-font-size: 12; -fx-text-fill: #555;" />
                <TextField fx:id="shipmentNumberField" alignment="CENTER_RIGHT" style="-fx-pref-width: 170; -fx-background-radius: 10;" />
            </VBox>
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="رقم UCR" style="-fx-font-size: 12; -fx-text-fill: #555;" />
                <TextField fx:id="ucrNumberField" alignment="CENTER_RIGHT" style="-fx-pref-width: 170; -fx-background-radius: 10;" />
            </VBox>
        </HBox>

        <VBox spacing="4" alignment="CENTER_RIGHT" style="-fx-padding: 0 0 0 0;">
            <Label text="طريقة الشحن" style="-fx-font-size: 12; -fx-text-fill: #555;" />
            <ComboBox fx:id="shippingMethodCombo" nodeOrientation="RIGHT_TO_LEFT" style="-fx-pref-width: 355; -fx-background-radius: 10;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="بحري" />
                        <String fx:value="جوي" />
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <!-- Destination Section -->
        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #690000;" text="بيانات الوجهة" />

        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="بلد الوصول" style="-fx-font-size: 12; -fx-text-fill: #555;" />
            <TextField fx:id="destinationCountryField" alignment="CENTER_RIGHT" style="-fx-pref-width: 355; -fx-background-radius: 10;" />
        </VBox>

        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="ميناء الوصول" style="-fx-font-size: 12; -fx-text-fill: #555;" />
            <TextField fx:id="destinationPortField" alignment="CENTER_RIGHT" style="-fx-pref-width: 355; -fx-background-radius: 10;" />
        </VBox>

        <!-- Shipment Details Section -->
        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #690000;" text="تفاصيل الشحنة" />

        <HBox spacing="10" alignment="CENTER">
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="عدد الحاويات" style="-fx-font-size: 11; -fx-text-fill: #555;" />
                <TextField fx:id="containersCountField" alignment="CENTER_RIGHT" style="-fx-pref-width: 110; -fx-background-radius: 10;" />
            </VBox>
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="الوزن (كجم)" style="-fx-font-size: 11; -fx-text-fill: #555;" />
                <TextField fx:id="totalWeightField" alignment="CENTER_RIGHT" style="-fx-pref-width: 110; -fx-background-radius: 10;" />
            </VBox>
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="القيمة (ج.م)" style="-fx-font-size: 11; -fx-text-fill: #555;" />
                <TextField fx:id="valueInEGPField" alignment="CENTER_RIGHT" style="-fx-pref-width: 110; -fx-background-radius: 10;" />
            </VBox>
        </HBox>

        <!-- Fees Section -->
        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #690000;" text="الرسوم والمصاريف" />

        <HBox spacing="15" alignment="CENTER">
            <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="إجمالي الرسوم" style="-fx-font-size: 12; -fx-text-fill: #555;" />
                <TextField fx:id="totalFeesField" alignment="CENTER_RIGHT" style="-fx-pref-width: 170; -fx-background-radius: 10;" />
            </VBox>
            <VBox spacing="4" alignment="CENTER">
                <Label text="حالة الدفع" style="-fx-font-size: 12; -fx-text-fill: #555;" />
                <CheckBox fx:id="feePaidCheckbox" text="تم الدفع" style="-fx-font-size: 13;" />
            </VBox>
        </HBox>

        <!-- Status Section -->
        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #690000;" text="حالة الشحنة" />

        <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="الحالة الحالية" style="-fx-font-size: 12; -fx-text-fill: #555;" />
            <ComboBox fx:id="statusCombo" nodeOrientation="RIGHT_TO_LEFT" style="-fx-pref-width: 355; -fx-background-radius: 10;">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="التحقق من المستندات" />
                        <String fx:value="فحص الجهات الرقابية" />
                        <String fx:value="تم السداد" />
                        <String fx:value="تم التحميل" />
                        <String fx:value="في الطريق" />
                        <String fx:value="تم التسليم" />
                        <String fx:value="مكتمل" />
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 15 0 0 0;">
            <Button onAction="#cancel" style="-fx-pref-width: 120; -fx-background-color: #aaa; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold;" text="إلغاء" />
            <Button onAction="#save" style="-fx-pref-width: 120; -fx-background-color: #690000; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold;" text="حفظ التعديلات" />
        </HBox>

    </VBox>
</ScrollPane>
