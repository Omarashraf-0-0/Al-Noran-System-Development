<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane style="-fx-background-image: url('noran/desktop/images/background.png');
                   -fx-background-size: cover;
                   -fx-background-position: center center;
                   -fx-background-repeat: no-repeat;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="noran.desktop.Controllers.OTPVerificationController">

    <!-- Background -->
    <ImageView fitHeight="768.0" fitWidth="1366.0" pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@images/background.png" />
        </image>
    </ImageView>

    <!-- Modern Glass Card -->
    <VBox maxWidth="440" maxHeight="420" prefWidth="440" prefHeight="420" spacing="22"
          alignment="CENTER"
          style="-fx-background-color: rgba(255,255,255,0.9);
                 -fx-background-radius: 24;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 8);"
          nodeOrientation="RIGHT_TO_LEFT"
          StackPane.alignment="CENTER">

        <padding>
            <Insets top="35" right="45" bottom="35" left="45"/>
        </padding>

        <!-- Back Link -->
        <HBox alignment="TOP_LEFT" prefWidth="380">
            <Hyperlink text="⬅️ الرجوع" onAction="#onBackClicked"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-text-fill: #888; -fx-underline: false;" />
        </HBox>

        <!-- Icon + Title -->
        <Label text="🔢 رمز التحقق (OTP)"
               style="-fx-font-family: 'Segoe UI', 'Poppins'; -fx-font-weight: 700;
                      -fx-font-size: 24; -fx-text-fill: #690000;" />
        
        <Label text="أدخل الرمز المرسل إلى بريدك الإلكتروني"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-text-fill: #666;" />

        <!-- OTP Fields - Left to Right Input -->
        <HBox spacing="12" alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT">
            <TextField fx:id="otp1" prefWidth="52" prefHeight="52"
                       style="-fx-background-radius: 14; -fx-font-size: 22; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 14;" />
            <TextField fx:id="otp2" prefWidth="52" prefHeight="52"
                       style="-fx-background-radius: 14; -fx-font-size: 22; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 14;" />
            <TextField fx:id="otp3" prefWidth="52" prefHeight="52"
                       style="-fx-background-radius: 14; -fx-font-size: 22; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 14;" />
            <TextField fx:id="otp4" prefWidth="52" prefHeight="52"
                       style="-fx-background-radius: 14; -fx-font-size: 22; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 14;" />
            <TextField fx:id="otp5" prefWidth="52" prefHeight="52"
                       style="-fx-background-radius: 14; -fx-font-size: 22; -fx-font-weight: bold; -fx-alignment: center; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 14;" />
        </HBox>

        <!-- Resend Link -->
        <Hyperlink text="🔄 إعادة إرسال الكود" onAction="#onResendClicked"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14;
                          -fx-text-fill: #3b82f6; -fx-underline: false;" />

        <!-- Confirm Button with Gradient -->
        <Button fx:id="confirmButton" text="✅ تأكيد الكود" onAction="#onConfirmClicked"
                prefWidth="220" prefHeight="48"
                style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 700;
                       -fx-font-size: 16; -fx-background-color: linear-gradient(to bottom, #8B0000, #690000);
                       -fx-background-radius: 14; -fx-text-fill: white;
                       -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 3);" />

    </VBox>

    <!-- Logo -->
    <ImageView fitHeight="240.0" fitWidth="230.0"
               preserveRatio="true" pickOnBounds="true"
               StackPane.alignment="TOP_LEFT">
        <image>
            <Image url="@images/Logo.png" />
        </image>
        <StackPane.margin>
            <Insets top="-10" />
        </StackPane.margin>
    </ImageView>

</StackPane>

