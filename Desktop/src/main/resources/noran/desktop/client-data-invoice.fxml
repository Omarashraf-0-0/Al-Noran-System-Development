<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ClientDataInvoiceController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>
    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 28 24;">
            <!-- Header with centered illustration and refresh button (bottom right) -->
            <AnchorPane prefHeight="180.0">
                <!-- Centered illustration using StackPane -->
                <StackPane alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
                    <ImageView fitHeight="180.0" fitWidth="320.0" preserveRatio="true">
                        <image>
                            <Image url="@images/invoice-illustration.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <!-- Refresh button anchored to bottom right (leftAnchor in RTL = visual right) -->
                <Button fx:id="refreshBtn" onAction="#refresh" style="-fx-background-color: transparent; -fx-cursor: hand;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <graphic>
                        <ImageView fitHeight="44.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/cached.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </AnchorPane>

            <!-- Action Buttons Row -->
            <HBox alignment="CENTER" spacing="16" style="-fx-padding: 8 0;">
                <Button fx:id="btnViewAcceptedInvoices" onAction="#openAcceptedInvoices" 
                    style="-fx-background-color: linear-gradient(to bottom, #a40000, #690000); -fx-text-fill: white; -fx-padding: 14 28; -fx-font-size: 14; -fx-background-radius: 12; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0, 0, 3); -fx-cursor: hand;" 
                    text="📋 عرض الفواتير المقبولة والمرسلة" />
            </HBox>

            <!-- Table Title -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 8;">
                <Label text="قائمة العملاء" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;" />
            </HBox>

            <!-- Table container with shadow -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                <TableView fx:id="invoicesTable" prefHeight="400" prefWidth="900" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colClientName" prefWidth="240" text="اسم العميل" style="-fx-alignment: CENTER-RIGHT;" />
                        <TableColumn fx:id="colClientNumber" prefWidth="220" text="الرقم الضريبي" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colClientType" prefWidth="200" text="نوع العميل" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colClientRank" prefWidth="180" text="رتبة العميل" style="-fx-alignment: CENTER;" />
                    </columns>
                </TableView>
            </StackPane>

            <!-- Footer hint -->
            <HBox alignment="CENTER" style="-fx-padding: 8 0;">
                <Label text="💡 اضغط على أي صف للوصول لتفاصيل العميل وفواتيره" style="-fx-font-size: 13; -fx-text-fill: #888;" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

