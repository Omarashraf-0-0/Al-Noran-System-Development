<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="780" prefWidth="1250" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ClientDataInvoiceController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>
    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 32 24;">
         <AnchorPane prefHeight="200.0" prefWidth="200.0">
            <children>
               <Button fx:id="updateClientBtn1" onAction="#editShipment" prefHeight="55.0" prefWidth="66.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" />
               <ImageView fitHeight="47.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@images/cached.png" />
                  </image>
               </ImageView>
            </children>
         </AnchorPane>

            <!-- زر الانتقال إلى الفواتير المقبولة -->
            <HBox alignment="CENTER_LEFT" prefHeight="49.0" prefWidth="326.0" spacing="12">
                <Button fx:id="btnViewAcceptedInvoices" onAction="#openAcceptedInvoices" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 14 32; -fx-font-size: 15; -fx-background-radius: 10; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);" text="عرض الفواتير المقبولة والمرسلة">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                            <image>
                                <Image url="@images/checklist.png" /> <!-- أيقونة اختيارية -->
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Illustration -->
            <ImageView fitHeight="188.0" fitWidth="311.0" preserveRatio="true">
                <image>
                    <Image url="@images/Untitled%20design%20(8).png" />
                </image>
            </ImageView>

            <!-- Table container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;">
                <TableView fx:id="invoicesTable" prefHeight="380" prefWidth="880" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">

                    <columns>
                        <TableColumn fx:id="colClientName" prefWidth="220" text="اسم العميل" />
                        <TableColumn fx:id="colClientNumber" prefWidth="220" text="الرقم التعريفي" />
                        <TableColumn fx:id="colClientType" prefWidth="220" text="نوع العميل" />
                        <TableColumn fx:id="colClientRank" prefWidth="220" text="رتبة العميل" />
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
