<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            prefHeight="780"
            prefWidth="1250"
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="noran.desktop.Controllers.ClientDataInvoiceController">

    <left>
        <fx:include source="Sidebar.fxml" fx:id="sidebar" />
    </left>

    <top>
        <fx:include source="TopBar.fxml" fx:id="topBar"/>
    </top>
    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 32 24;">

            <!-- زر الانتقال إلى الفواتير المقبولة -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button fx:id="btnViewAcceptedInvoices"
                        text="عرض الفواتير المقبولة والمرسلة"
                        onAction="#openAcceptedInvoices"
                        style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-padding: 14 32; -fx-font-size: 15; -fx-background-radius: 10; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 2);">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="20">
                            <image>
                                <Image url="@images/checklist.png" /> <!-- أيقونة اختيارية -->
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <!-- Illustration -->
            <ImageView fitHeight="220" preserveRatio="true">
                <image>
                    <Image url="@images/invoice-illustration.png" />
                </image>
            </ImageView>

            <!-- Table container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;">
                <TableView fx:id="invoicesTable"
                           prefHeight="380"
                           prefWidth="880"
                           stylesheets="@invoices-table.css"
                           style="-fx-background-color: transparent;">

                    <columns>
                        <TableColumn fx:id="colClientName" text="اسم العميل" prefWidth="220"/>
                        <TableColumn fx:id="colClientNumber" text="الرقم التعريفي" prefWidth="220"/>
                        <TableColumn fx:id="colClientType" text="نوع العميل" prefWidth="220"/>
                        <TableColumn fx:id="colClientRank" text="رتبة العميل" prefWidth="220"/>
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </center>
</BorderPane>