<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" 
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: linear-gradient(to bottom right, #f8f9fa, #eef1f5);" 
            stylesheets="@dashboard.css" 
            xmlns="http://javafx.com/javafx/17.0.2-ea" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.DashboardController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="28" style="-fx-padding: 32 40;">

                <!-- Welcome Header -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox alignment="CENTER_LEFT" spacing="4">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" text="مرحباً بك في لوحة التحكم"/>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="إليك نظرة عامة على أداء النظام"/>
                    </VBox>
                </HBox>

                <!-- TOP STAT CARDS -->
                <GridPane hgap="24" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <!-- Card 1: إجمالي الإيرادات -->
                    <StackPane styleClass="stat-card" GridPane.columnIndex="0">
                        <VBox alignment="TOP_RIGHT" spacing="12">
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 500;" text="إجمالي الإيرادات"/>
                                <StackPane prefWidth="40" prefHeight="40">
                                    <Circle radius="20" style="-fx-fill: linear-gradient(to bottom right, #a40000, #7a0000);"/>
                                    <Label text="💰" style="-fx-font-size: 18px;"/>
                                </StackPane>
                            </HBox>
                            <Label fx:id="totalRevenueLabel" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="0.00"/>
                            <HBox alignment="CENTER_RIGHT" spacing="6">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="جنيه مصري"/>
                                <Label text="📈" style="-fx-font-size: 12px;"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Card 2: الفواتير المعلقة -->
                    <StackPane styleClass="stat-card" GridPane.columnIndex="1">
                        <VBox alignment="TOP_RIGHT" spacing="12">
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 500;" text="الفواتير المعلقة"/>
                                <StackPane prefWidth="40" prefHeight="40">
                                    <Circle radius="20" style="-fx-fill: linear-gradient(to bottom right, #D4AF37, #b8941f);"/>
                                    <Label text="⏳" style="-fx-font-size: 18px;"/>
                                </StackPane>
                            </HBox>
                            <Label fx:id="pendingInvoicesLabel" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #D4AF37;" text="0"/>
                            <HBox alignment="CENTER_RIGHT" spacing="6">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="فاتورة"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Card 3: الشهادات المكتملة -->
                    <StackPane styleClass="stat-card" GridPane.columnIndex="2">
                        <VBox alignment="TOP_RIGHT" spacing="12">
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 500;" text="الشهادات المكتملة"/>
                                <StackPane prefWidth="40" prefHeight="40">
                                    <Circle radius="20" style="-fx-fill: linear-gradient(to bottom right, #10b981, #059669);"/>
                                    <Label text="✅" style="-fx-font-size: 18px;"/>
                                </StackPane>
                            </HBox>
                            <Label fx:id="completedInvoicesLabel" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #10b981;" text="0"/>
                            <HBox alignment="CENTER_RIGHT" spacing="6">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="شهادة"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <!-- Card 4: الشحنات الجارية -->
                    <StackPane styleClass="stat-card" GridPane.columnIndex="3">
                        <VBox alignment="TOP_RIGHT" spacing="12">
                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px; -fx-font-weight: 500;" text="الشهادات الجارية"/>
                                <StackPane prefWidth="40" prefHeight="40">
                                    <Circle radius="20" style="-fx-fill: linear-gradient(to bottom right, #3b82f6, #2563eb);"/>
                                    <Label text="🚚" style="-fx-font-size: 18px;"/>
                                </StackPane>
                            </HBox>
                            <Label fx:id="ongoingShipmentsLabel" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #3b82f6;" text="0"/>
                            <HBox alignment="CENTER_RIGHT" spacing="6">
                                <Label style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;" text="شحنة"/>
                            </HBox>
                        </VBox>
                    </StackPane>
                    
                    <rowConstraints>
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <!-- CHARTS SECTION -->
                <VBox spacing="0" styleClass="charts-container">
                    <!-- Header -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #a40000, #7a0000, #520000); -fx-background-radius: 20 20 0 0; -fx-padding: 20 32;">

                        <Label style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: white;" text="الإحصائيات والتقارير"/>
                        <Label text="📊" style="-fx-font-size: 24px;"/>
                    </HBox>
                    
                    <!-- Charts Content -->
                    <VBox alignment="CENTER" spacing="28" style="-fx-background-color: white; -fx-background-radius: 0 0 20 20; -fx-padding: 32;">
                        <HBox alignment="CENTER" spacing="40">
                            <!-- Chart 1 -->
                            <VBox alignment="CENTER" spacing="14" styleClass="chart-box">
                                <Label style="-fx-font-weight: 600; -fx-font-size: 14px; -fx-text-fill: #374151;" text="نسبة الفواتير المقبولة والمعلقة"/>
                                <PieChart fx:id="chartAcceptedVsPending" prefHeight="180" prefWidth="180" legendVisible="false"/>
                            </VBox>

                            <!-- Chart 2 -->
                            <VBox alignment="CENTER" spacing="14" styleClass="chart-box">
                                <Label style="-fx-font-weight: 600; -fx-font-size: 14px; -fx-text-fill: #374151;" text="الفواتير المعلقة مقابل المعالجة"/>
                                <PieChart fx:id="chartPendingInvoicesRatio" prefHeight="180" prefWidth="180" legendVisible="false"/>
                            </VBox>

                            <!-- Chart 3 -->
                            <VBox alignment="CENTER" spacing="14" styleClass="chart-box">
                                <Label style="-fx-font-weight: 600; -fx-font-size: 14px; -fx-text-fill: #374151;" text="توزيع العملاء حسب الإصدار"/>
                                <PieChart fx:id="chartClientsByVersion" prefHeight="180" prefWidth="180" legendVisible="false"/>
                            </VBox>
                        </HBox>
                        
                        <!-- Download Button -->
                        <Button fx:id="downloadReportBtn" onAction="#downloadDashboardReport" styleClass="primary-button"
                            text="📥  تحميل تقرير الإحصائيات كـ PDF"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
