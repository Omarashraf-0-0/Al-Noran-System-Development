<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: #f8f9fa;" stylesheets="@charts.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.DashboardController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="24" style="-fx-padding: 28 40;">

            <!-- TOP STAT CARDS -->
            <GridPane hgap="20" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                    <ColumnConstraints percentWidth="25" />
                </columnConstraints>

                <!-- Card 1: إجمالي الإيرادات -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #1ba3b6 transparent transparent transparent; -fx-border-width: 4 0 0 0; -fx-border-radius: 16 16 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4);" GridPane.columnIndex="0">
                    <VBox alignment="TOP_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #666; -fx-font-size: 14;" text="💰 إجمالي الإيرادات" />
                        <Label fx:id="totalRevenueLabel" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1ba3b6;" text="0.00" />
                        <Label style="-fx-text-fill: #999; -fx-font-size: 12;" text="جنيه مصري" />
                    </VBox>
                </StackPane>

                <!-- Card 2: الفواتير المعلقة -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #a40000 transparent transparent transparent; -fx-border-width: 4 0 0 0; -fx-border-radius: 16 16 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4);" GridPane.columnIndex="1">
                    <VBox alignment="TOP_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #666; -fx-font-size: 14;" text="⏳ عدد الفواتير المعلقة" />
                        <Label fx:id="pendingInvoicesLabel" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #a40000;" text="0" />
                    </VBox>
                </StackPane>

                <!-- Card 3: الشهادات المكتملة (الفواتير المقبولة) -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #690000 transparent transparent transparent; -fx-border-width: 4 0 0 0; -fx-border-radius: 16 16 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4);" GridPane.columnIndex="2">
                    <VBox alignment="TOP_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #666; -fx-font-size: 14;" text="✅ عدد الشهادات المكتملة" />
                        <Label fx:id="completedInvoicesLabel" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #690000;" text="0" />
                    </VBox>
                </StackPane>

                <!-- Card 4: الشحنات الجارية -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 22; -fx-border-color: #1ba3b6 transparent transparent transparent; -fx-border-width: 4 0 0 0; -fx-border-radius: 16 16 0 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 12, 0, 0, 4);" GridPane.columnIndex="3">
                    <VBox alignment="TOP_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #666; -fx-font-size: 14;" text="🚚 عدد الشهادات الجارية" />
                        <Label fx:id="ongoingShipmentsLabel" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1ba3b6;" text="0" />
                    </VBox>
                </StackPane>
            <rowConstraints>
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- CHARTS SECTION -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 32; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 16, 0, 0, 6);">
                <VBox alignment="TOP_CENTER" spacing="28">
                    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333;" text="📊 الإحصائيات والتقارير" />

                    <HBox alignment="CENTER" spacing="50">
                        <!-- Chart 1: نسبة المقبولة vs المعلقة -->
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 16; -fx-background-color: #fafafa; -fx-background-radius: 12;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #555;" text="نسبة الفواتير المقبولة والمعلقة" />
                            <PieChart fx:id="chartAcceptedVsPending" prefHeight="200" prefWidth="200" stylesheets="charts.css" />
                        </VBox>

                        <!-- Chart 2: نسبة الفواتير المعلقة فقط -->
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 16; -fx-background-color: #fafafa; -fx-background-radius: 12;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #555;" text="الفواتير المعلقة مقابل المعالجة" />
                            <PieChart fx:id="chartPendingInvoicesRatio" prefHeight="200" prefWidth="200" stylesheets="charts.css" />
                        </VBox>

                        <!-- Chart 3: توزيع العملاء حسب الإصدار -->
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 16; -fx-background-color: #fafafa; -fx-background-radius: 12;">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #555;" text="توزيع العملاء حسب الإصدار" />
                            <PieChart fx:id="chartClientsByVersion" prefHeight="200" prefWidth="200" stylesheets="charts.css" />
                        </VBox>
                    </HBox>
                    
                    <Button fx:id="downloadReportBtn" onAction="#downloadDashboardReport" 
                        style="-fx-background-color: linear-gradient(to bottom, #a40000, #690000); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 36; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);" 
                        text="📥 تحميل تقرير الإحصائيات كـ PDF" />
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>

