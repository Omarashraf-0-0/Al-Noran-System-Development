<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" 
    style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: #f8f9fa;" 
    xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="noran.desktop.Controllers.ProfileController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="28" style="-fx-padding: 32 48;">

                <!-- HEADER CARD - Hero Section with Gradient -->
                <StackPane style="-fx-background-color: #a40000; 
                                  -fx-background-radius: 24; 
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25, 0, 0, 8);">
                    <VBox alignment="CENTER" spacing="16" style="-fx-padding: 40;">
                        
                        <!-- Profile Photo Container -->
                        <StackPane>
                            <!-- Outer Ring -->
                            <Circle radius="55" style="-fx-fill: rgba(255,255,255,0.25);" />
                            <!-- Inner White Border -->
                            <Circle radius="50" style="-fx-fill: white;" />
                            <!-- Profile Image -->
                            <StackPane fx:id="profileImageContainer" prefWidth="90" prefHeight="90" maxWidth="90" maxHeight="90"
                                style="-fx-background-radius: 45; -fx-background-color: #f0f0f0;">
                                <ImageView fx:id="profileImage" fitWidth="90" fitHeight="90" preserveRatio="false">
                                    <clip>
                                        <Circle radius="45" centerX="45" centerY="45" />
                                    </clip>
                                </ImageView>
                                <!-- Default Avatar Icon -->
                                <Label fx:id="defaultAvatar" text="👤" style="-fx-font-size: 36;" />
                            </StackPane>
                        </StackPane>

                        <!-- Name & Role -->
                        <VBox alignment="CENTER" spacing="4">
                            <Label fx:id="fullnameLabel" text="اسم المستخدم" 
                                style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;" />
                            <HBox alignment="CENTER" spacing="8">
                                <Label fx:id="roleLabel" text="الدور" 
                                    style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-weight: 600;" />
                                <Label fx:id="roleBadge" text="مدير النظام" 
                                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 20; 
                                           -fx-padding: 4 16; -fx-text-fill: white; -fx-font-size: 13;" />
                            </HBox>
                        </VBox>

                        <!-- Status Badge -->
                        <HBox alignment="CENTER" spacing="8">
                            <Circle fx:id="statusIndicator" radius="5" style="-fx-fill: #22c55e;" />
                            <Label fx:id="statusLabel" text="نشط" 
                                style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14;" />
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- INFO CARDS GRID -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Personal Info Card -->
                    <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; 
                                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 6);" 
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <!-- Card Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12" 
                            style="-fx-background-color: #a40000; -fx-background-radius: 20 20 0 0; -fx-padding: 16 24;">
                            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 8;">
                                <Label text="👤" style="-fx-font-size: 20;" />
                            </StackPane>
                            <Label text="المعلومات الشخصية" 
                                style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
                        </HBox>
                        
                        <!-- Card Content -->
                        <VBox spacing="16" style="-fx-padding: 20 24;">
                            <!-- Username Row -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="اسم المستخدم" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="usernameLabel" text="aly" 
                                        style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #333;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #3b82f6; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="🆔" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>

                            <Separator style="-fx-background-color: #eee;" />

                            <!-- Full Name Row -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="الاسم الكامل" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="fullnameInfoLabel" text="عمك على" 
                                        style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #333;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #f59e0b; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="✨" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>

                            <Separator style="-fx-background-color: #eee;" />

                            <!-- Account Type Row -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="نوع الحساب" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="employeeTypeLabel" text="System Admin" 
                                        style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #a40000;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #a40000; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="👔" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Contact Info Card -->
                    <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; 
                                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 6);" 
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <!-- Card Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12" 
                            style="-fx-background-color: #1ba3b6; -fx-background-radius: 20 20 0 0; -fx-padding: 16 24;">
                            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 8;">
                                <Label text="📞" style="-fx-font-size: 20;" />
                            </StackPane>
                            <Label text="معلومات الاتصال" 
                                style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
                        </HBox>
                        
                        <!-- Card Content -->
                        <VBox spacing="16" style="-fx-padding: 20 24;">
                            <!-- Email Row -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="البريد الإلكتروني" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="emailLabel" text="email@example.com" nodeOrientation="LEFT_TO_RIGHT"
                                        style="-fx-font-size: 15; -fx-font-weight: 600; -fx-text-fill: #333;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #10b981; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="📧" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>

                            <Separator style="-fx-background-color: #eee;" />

                            <!-- Phone Row -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="رقم الهاتف" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="phoneLabel" text="01151005959" nodeOrientation="LEFT_TO_RIGHT"
                                        style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #333;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #22c55e; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="📱" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>

                            <Separator style="-fx-background-color: #eee;" />

                            <!-- Verified Status -->
                            <HBox alignment="CENTER_RIGHT" spacing="12">
                                <VBox alignment="TOP_RIGHT" spacing="2" HBox.hgrow="ALWAYS">
                                    <Label text="حالة التحقق" style="-fx-text-fill: #888; -fx-font-size: 12;" />
                                    <Label fx:id="verifiedLabel" text="غير موثق" 
                                        style="-fx-font-size: 16; -fx-font-weight: 600; -fx-text-fill: #f59e0b;" />
                                </VBox>
                                <StackPane style="-fx-background-color: #f59e0b; -fx-background-radius: 12; -fx-padding: 12;">
                                    <Label text="✔" style="-fx-font-size: 20;" />
                                </StackPane>
                            </HBox>
                        </VBox>
                    </VBox>
                </GridPane>

                <!-- ACCOUNT INFO CARD -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 20; 
                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 6);">
                    <!-- Card Header -->
                    <HBox alignment="CENTER_LEFT" spacing="12" 
                        style="-fx-background-color: #690000; -fx-background-radius: 20 20 0 0; -fx-padding: 16 24;">
                        <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 8;">
                            <Label text="📊" style="-fx-font-size: 20;" />
                        </StackPane>
                        <Label text="معلومات الحساب" 
                            style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;" />
                    </HBox>
                    
                    <!-- Card Content - Horizontal Layout -->
                    <HBox spacing="0" style="-fx-padding: 32 24;">
                        <!-- Created At -->
                        <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS" 
                            style="-fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 0 2 0 0; -fx-padding: 0 20 0 0;">
                            <StackPane style="-fx-background-color: #3b82f6; -fx-background-radius: 16; -fx-padding: 16;">
                                <Label text="🗓" style="-fx-font-size: 28;" />
                            </StackPane>
                            <Label text="تاريخ الإنشاء" style="-fx-text-fill: #6b7280; -fx-font-size: 14; -fx-font-weight: 500;" />
                            <Label fx:id="createdAtLabel" text="30 نوفمبر 2025" 
                                style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Last Update -->
                        <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS"
                            style="-fx-border-color: transparent #e5e7eb transparent transparent; -fx-border-width: 0 2 0 0; -fx-padding: 0 20;">
                            <StackPane style="-fx-background-color: #f59e0b; -fx-background-radius: 16; -fx-padding: 16;">
                                <Label text="🕐" style="-fx-font-size: 28;" />
                            </StackPane>
                            <Label text="آخر تحديث" style="-fx-text-fill: #6b7280; -fx-font-size: 14; -fx-font-weight: 500;" />
                            <Label fx:id="updatedAtLabel" text="14 ديسمبر 2025" 
                                style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1f2937;" />
                        </VBox>

                        <!-- Account Status -->
                        <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS" style="-fx-padding: 0 0 0 20;">
                            <StackPane style="-fx-background-color: #10b981; -fx-background-radius: 16; -fx-padding: 16;">
                                <Label text="⚡" style="-fx-font-size: 28;" />
                            </StackPane>
                            <Label text="حالة الحساب" style="-fx-text-fill: #6b7280; -fx-font-size: 14; -fx-font-weight: 500;" />
                            <Label fx:id="activeLabel" text="نشط" 
                                style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                        </VBox>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
