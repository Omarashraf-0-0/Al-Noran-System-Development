<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" 
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: linear-gradient(to bottom right, #f8f9fa, #eef1f5);" 
            stylesheets="@shipments.css"
            xmlns="http://javafx.com/javafx/17.0.12" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.AdminAddInvoiceController">

    <stylesheets>
        <String fx:value="@invoices-table.css" />
    </stylesheets>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 32 40;">
                
                <!-- Page Header -->
                <HBox alignment="CENTER" spacing="0">
                    <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane prefWidth="50" prefHeight="50">
                                <Circle radius="25" style="-fx-fill: linear-gradient(to bottom right, #a40000, #7a0000);"/>
                                <Label text="➕" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="إنشاء فاتورة جديدة" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;"/>
                                <Label text="إضافة فاتورة جديدة للعميل" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Client Name Input -->
                <VBox spacing="0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 4);">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #a40000, #7a0000); -fx-background-radius: 16 16 0 0; -fx-padding: 14 24;">
                        <Label text="بيانات الفاتورة" style="-fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                        <Label text="📋" style="-fx-font-size: 16px;"/>
                    </HBox>
                    
                    <HBox spacing="30" style="-fx-padding: 20 24;" alignment="CENTER_RIGHT">
                        <!-- Client Name Field -->
                        <HBox alignment="CENTER_RIGHT" spacing="12" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-weight: 600; -fx-font-size: 14px; -fx-text-fill: #374151;" text="اسم العميل:" />
                            <TextField fx:id="clientNameField" HBox.hgrow="ALWAYS" promptText="أدخل اسم العميل"
                                style="-fx-background-radius: 8; -fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-padding: 10 14;" />
                        </HBox>
                        
                        <!-- Separator -->
                        <Label text="|" style="-fx-text-fill: #e5e7eb; -fx-font-size: 24px;" />
                        
                        <!-- Invoice Number -->
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #6b7280; -fx-font-size: 13px;" text="رقم الفاتورة:" />
                            <Label fx:id="invoiceNumberLabel" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="INV-XXXXXX" />
                        </HBox>
                        
                        <!-- Separator -->
                        <Label text="|" style="-fx-text-fill: #e5e7eb; -fx-font-size: 24px;" />
                        
                        <!-- Date -->
                        <HBox spacing="8" alignment="CENTER_RIGHT">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #6b7280; -fx-font-size: 13px;" text="التاريخ:" />
                            <Label fx:id="invoiceDateLabel" style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" text="00/00/0000" />
                        </HBox>
                    </HBox>
                </VBox>

                <!-- Actions Row -->
                <HBox alignment="CENTER_RIGHT" spacing="14">
                    <Button fx:id="addRowBtn" onAction="#addNewRow" styleClass="success-button">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <Label text="➕" style="-fx-font-size: 14px;"/>
                                <Label text="إضافة بند جديد" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: 600;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    
                    <Button fx:id="deleteRowBtn" onAction="#deleteSelectedRow" styleClass="danger-button">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <Label text="🗑️" style="-fx-font-size: 14px;"/>
                                <Label text="مسح العنصر" style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: 600;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label fx:id="totalLabel" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #a40000; -fx-background-color: rgba(164,0,0,0.08); -fx-padding: 12 20; -fx-background-radius: 12;" text="المجموع الكلي: 0.00 جنيه" />
                </HBox>

                <!-- Table with Logo Watermark -->
                <VBox spacing="0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #a40000, #7a0000); -fx-background-radius: 16 16 0 0; -fx-padding: 16 24;">
                        <Label text="بنود الفاتورة" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                        <Label text="📋" style="-fx-font-size: 18px;"/>
                    </HBox>
                    
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 0 0 16 16; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <ImageView fitWidth="350" mouseTransparent="true" opacity="0.06" preserveRatio="true">
                            <image>
                                <Image url="@/noran/desktop/images/Logo.png" />
                            </image>
                        </ImageView>
                        <TableView fx:id="invoiceTable" style="-fx-background-color: transparent; -fx-padding: 0; -fx-background-insets: 0;" stylesheets="@invoices-table.css">
                            <columns>
                                <TableColumn fx:id="colDesc" text="الوصف" />
                                <TableColumn fx:id="colPrice" text="السعر" />
                            </columns>
                        </TableView>
                    </StackPane>
                </VBox>

                <!-- Generate PDF Button -->
                <HBox alignment="CENTER" style="-fx-padding: 8 0;">
                    <Button onAction="#generatePdf" style="-fx-background-color: linear-gradient(to bottom, #10b981, #059669); -fx-background-radius: 14; -fx-padding: 16 48; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.35), 12, 0, 0, 4);">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="📥" style="-fx-font-size: 20px;"/>
                                <Label text="إنشاء وتحميل PDF" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-font-weight: 700;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
