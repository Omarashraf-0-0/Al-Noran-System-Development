<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" 
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: linear-gradient(to bottom right, #f8f9fa, #eef1f5);" 
            stylesheets="@shipments.css"
            xmlns="http://javafx.com/javafx/17.0.12" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.AcceptedInvoicesController">

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <right>
        <fx:include fx:id="sidebar" source="Sidebar.fxml"/>
    </right>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 40;">
                
                <!-- Page Header -->
                <HBox alignment="CENTER" spacing="0">
                    <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane prefWidth="50" prefHeight="50">
                                <Circle radius="25" style="-fx-fill: linear-gradient(to bottom right, #10b981, #059669);"/>
                                <Label text="✅" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="الفواتير المقبولة والمرسلة" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;"/>
                                <Label text="عرض جميع الفواتير التي تم قبولها وإرسالها" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Refresh Button -->
                    <Button fx:id="refreshBtn" onAction="#refresh" styleClass="refresh-button">
                        <graphic>
                            <HBox alignment="CENTER" spacing="8">
                                <Label text="🔄" style="-fx-font-size: 18px;"/>
                                <Label text="تحديث" style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-weight: 700;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>



                <!-- Table Section -->
                <VBox spacing="0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <!-- Table Header -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #10b981, #059669); -fx-background-radius: 16 16 0 0; -fx-padding: 16 24;">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="الفواتير المقبولة" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                        <Label text="📋" style="-fx-font-size: 18px;"/>
                    </HBox>
                    
                    <!-- Table -->
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 0 0 16 16; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <TableView fx:id="acceptedInvoicesTable" prefHeight="480" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                            <columns>
                                <TableColumn fx:id="colInvoiceNumber" text="رقم الفاتورة" />
                                <TableColumn fx:id="colClientName" text="اسم العميل" />
                                <TableColumn fx:id="colTotalAmount" text="المجموع الكلي" />
                                <TableColumn fx:id="colDate" text="تاريخ الإنشاء" />
                                <TableColumn fx:id="colActions" text="عمليات" />
                            </columns>
                        </TableView>
                    </StackPane>
                </VBox>
                
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
