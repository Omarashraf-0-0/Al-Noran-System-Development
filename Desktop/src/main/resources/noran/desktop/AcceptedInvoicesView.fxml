<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="780" prefWidth="1250" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.AcceptedInvoicesController">

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <!-- Main Content -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 30 40;">
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="الفواتير المقبولة والمرسلة" />

            <!-- Back Button -->
            <HBox alignment="CENTER_LEFT">
                <Button onAction="#goBack" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 28; -fx-font-size: 14; -fx-background-radius: 8; -fx-font-weight: bold;" text="رجوع إلى إنشاء الفواتير" />
            </HBox>

            <!-- Table -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                <TableView fx:id="acceptedInvoicesTable" prefHeight="520" prefWidth="1000" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colInvoiceNumber" prefWidth="200" text="رقم الفاتورة" />
                        <TableColumn fx:id="colClientName" prefWidth="300" text="اسم العميل" />
                        <TableColumn fx:id="colTotalAmount" prefWidth="180" text="المجموع الكلي" />
                        <TableColumn fx:id="colDate" prefWidth="180" text="تاريخ الإنشاء" />
                        <TableColumn fx:id="colActions" prefWidth="140" text="عمليات" />
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
