<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" 
            xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.ImportShipmentPopupController">
    <VBox alignment="CENTER" spacing="18" 
          style="-fx-background-color: white; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #e9ecef; -fx-border-width: 1; -fx-min-width: 440;">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <!-- Logo -->
        <ImageView fitHeight="60.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@images/Logo.png" /></image>
        </ImageView>

        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #690000;" text="تعديل شحنة الاستيراد" />

        <!-- Basic Info Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="📦 معلومات الشحنة الأساسية" />

            <HBox spacing="14" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رقم ACID" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="acidField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رقم البوليصة" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="policyField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
            </HBox>

            <HBox spacing="14" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رقم 46" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="number46Field" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="عدد الحاويات" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="containersField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Location Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="🌍 بيانات الموقع" />

            <HBox spacing="14" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="اسم الميناء" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="portField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="الدولة" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="countryField" alignment="CENTER_RIGHT" prefWidth="175" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Parties Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="👥 بيانات الأطراف" />

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="اسم المستورد" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <TextField fx:id="importerNameField" alignment="CENTER_RIGHT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="اسم صاحب العمل" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <TextField fx:id="employerNameField" alignment="CENTER_RIGHT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
            </VBox>

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="وصف الشحنة" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <TextField fx:id="shipmentDescriptionField" alignment="CENTER_RIGHT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 12 14; -fx-font-size: 14px;" />
            </VBox>
        </VBox>

        <!-- Fees Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="💰 الرسوم والمصاريف" />

            <HBox spacing="10" alignment="CENTER">
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="رسوم التخليص" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="clearanceFeesField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="مصاريف وإكراميات" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="expensesField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
                <VBox spacing="6" alignment="CENTER_RIGHT">
                    <Label text="نثريات" style="-fx-font-size: 11px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                    <TextField fx:id="sundriesField" alignment="CENTER_RIGHT" prefWidth="115" 
                        style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 10 12; -fx-font-size: 14px;" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Status Section -->
        <VBox spacing="12" nodeOrientation="RIGHT_TO_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #a40000;" text="📊 حالة الشحنة" />

            <VBox spacing="6" alignment="CENTER_RIGHT">
                <Label text="الحالة الحالية" style="-fx-font-size: 12px; -fx-text-fill: #6b7280; -fx-font-weight: 500;" />
                <ComboBox fx:id="statusCombo" nodeOrientation="RIGHT_TO_LEFT" prefWidth="370" 
                    style="-fx-background-color: #f8f9fa; -fx-background-radius: 12; -fx-border-color: #e9ecef; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 6 10; -fx-font-size: 14px;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="في انتظار الشحن" />
                            <String fx:value="في الطريق" />
                            <String fx:value="وصلت" />
                            <String fx:value="التخليص الجمركي" />
                            <String fx:value="تمت بنجاح" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <HBox spacing="24" alignment="CENTER" style="-fx-padding: 8 0;">
                <CheckBox fx:id="dragtCheckbox" text="ادرجت" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
                <CheckBox fx:id="isInvoicedCheckbox" text="تم إصدار فاتورة" style="-fx-font-size: 14px; -fx-text-fill: #495057;" />
            </HBox>
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="16" style="-fx-padding: 16 0 0 0;">
            <Button onAction="#cancel" prefWidth="130" prefHeight="46"
                style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-text-fill: #495057; -fx-font-size: 15px; -fx-font-weight: 600; -fx-cursor: hand;" 
                text="إلغاء" />
            <Button onAction="#save" prefWidth="130" prefHeight="46"
                style="-fx-background-color: linear-gradient(to bottom, #c41e1e, #a40000, #7a0000); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: 700; -fx-cursor: hand;" 
                text="حفظ التعديلات" />
        </HBox>

    </VBox>
</ScrollPane>
