<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="560.0" prefWidth="420.0" spacing="20" 
      style="-fx-background-color: white; -fx-background-radius: 24; -fx-border-radius: 24; -fx-border-color: #e9ecef; -fx-border-width: 1;" 
      xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="noran.desktop.Controllers.EmployeePopupController">
    <padding>
        <Insets top="36" right="40" bottom="36" left="40"/>
    </padding>

    <!-- Avatar -->
    <ImageView fitHeight="100.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@images/AVATAR 1.png" />
        </image>
    </ImageView>

    <!-- Title -->
    <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #690000;" text="بيانات الموظف" />

    <!-- Form Fields -->
    <VBox spacing="14" style="-fx-padding: 10 0;" nodeOrientation="RIGHT_TO_LEFT">
        <TextField fx:id="fullnameField" alignment="CENTER_RIGHT" promptText="اسم الموظف" 
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 14 18; -fx-font-size: 15px; -fx-prompt-text-fill: #adb5bd;" />

        <TextField fx:id="emailField" alignment="CENTER_RIGHT" promptText="البريد الإلكتروني" 
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 14 18; -fx-font-size: 15px; -fx-prompt-text-fill: #adb5bd;" />

        <TextField fx:id="phoneField" alignment="CENTER_RIGHT" promptText="رقم الهاتف" 
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 14 18; -fx-font-size: 15px; -fx-prompt-text-fill: #adb5bd;" />

        <TextField fx:id="passwordField" alignment="CENTER_RIGHT" promptText="كلمة المرور" 
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 14 18; -fx-font-size: 15px; -fx-prompt-text-fill: #adb5bd;" />

        <ComboBox fx:id="jobTypeField" nodeOrientation="RIGHT_TO_LEFT" prefWidth="340.0" promptText="المسمى الوظيفي" 
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-padding: 8 12; -fx-font-size: 15px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Regular Employee" />
                    <String fx:value="Certified Employee" />
                    <String fx:value="Department Manager" />
                    <String fx:value="System Admin" />
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="16" style="-fx-padding: 16 0 0 0;">
        <Button onAction="#cancel" prefWidth="130" prefHeight="48"
            style="-fx-background-color: #f8f9fa; -fx-background-radius: 14; -fx-border-color: #e9ecef; -fx-border-radius: 14; -fx-border-width: 2; -fx-text-fill: #495057; -fx-font-size: 16px; -fx-font-weight: 600; -fx-cursor: hand;" 
            text="إلغاء" />
        <Button onAction="#save" prefWidth="130" prefHeight="48"
            style="-fx-background-color: linear-gradient(to bottom, #c41e1e, #a40000, #7a0000); -fx-background-radius: 14; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700; -fx-cursor: hand;" 
            text="حفظ البيانات" />
    </HBox>
</VBox>
