<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ExportShipmentsController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Header with centered illustration and refresh button (bottom right) -->
            <AnchorPane prefHeight="200.0">
                <!-- Centered illustration using StackPane -->
                <StackPane alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
                    <ImageView fitHeight="200.0" fitWidth="350.0" preserveRatio="true">
                        <image>
                            <Image url="@images/invoice-illustration.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <!-- Refresh button anchored to bottom right (leftAnchor in RTL = visual right) -->
                <Button onAction="#refresh" style="-fx-background-color: transparent; -fx-cursor: hand;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <graphic>
                        <ImageView fitHeight="47.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/cached.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </AnchorPane>

            <!-- Table Container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
                <TableView fx:id="exportsTable" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colCustomerName" prefWidth="180" text="اسم العميل" />
                        <TableColumn fx:id="colShipmentNumber" prefWidth="160" text="رقم الشحنة" />
                        <TableColumn fx:id="colUcrNumber" prefWidth="120" text="رقم UCR" />
                        <TableColumn fx:id="colDestinationCountry" prefWidth="150" text="بلد الوصول" />
                        <TableColumn fx:id="colDestinationPort" prefWidth="150" text="ميناء الوصول" />
                        <TableColumn fx:id="colStatus" prefWidth="140" text="الحالة" />
                    </columns>
                </TableView>
            </StackPane>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="editExportBtn" onAction="#editExport" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="تعديل الشحنة" />
                <Button fx:id="deleteExportBtn" onAction="#deleteExport" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="مسح الشحنة" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
