<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="563.0" prefWidth="350.0" spacing="15" style="-fx-padding: 25; -fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-border-radius: 15;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ClientPopupController">
   <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@images/Untitled%20design%20(10).png" />
      </image>
   </ImageView>

    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333;" text="إضافة عميل جديد" />

    <TextField fx:id="fullnameField" alignment="CENTER_RIGHT" promptText="اسم العميل" style="-fx-pref-width: 300; -fx-font-size: 14;" />

    <TextField fx:id="passwordField" alignment="CENTER_RIGHT" promptText="كلمة السر" style="-fx-pref-width: 300; -fx-font-size: 14;" />

    <TextField fx:id="phoneField" alignment="CENTER_RIGHT" promptText="رقم الهاتف" style="-fx-pref-width: 300; -fx-font-size: 14;" />

    <TextField fx:id="ssnField" alignment="CENTER_RIGHT" promptText="الرقم التعريفي / الرقم القومي" style="-fx-pref-width: 300; -fx-font-size: 14;" />

    <ComboBox fx:id="clientTypeField" editable="false" nodeOrientation="RIGHT_TO_LEFT" promptText="نوع العميل" style="-fx-background-color:#ffffff; -fx-pref-width: 300; -fx-font-size: 14;">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="personal" />
                <String fx:value="business" />
            </FXCollections>
        </items>
    </ComboBox>

    <TextField fx:id="emailField" alignment="CENTER_RIGHT" promptText="البريد الإلكتروني" style="-fx-pref-width: 300; -fx-font-size: 14;" />

    <HBox alignment="CENTER" spacing="20">
        <Button onAction="#cancel" style="-fx-pref-width: 120; -fx-background-color: #aaa; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="إلغاء" />
        <Button onAction="#save" style="-fx-pref-width: 120; -fx-background-color: #690000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="إضافة" />
    </HBox>
</VBox>
