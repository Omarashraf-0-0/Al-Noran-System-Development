<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane style="-fx-background-image: url('noran/desktop/images/background.png'); -fx-background-size: cover; -fx-background-position: center center; -fx-background-repeat: no-repeat;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.LoginController">

    <!-- Background Image that scales -->
    <ImageView fitHeight="768.0" fitWidth="1366.0" pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@images/background.png" />
        </image>
    </ImageView>

    <!-- Modern Login Card - Glass Effect -->
    <VBox alignment="CENTER" maxHeight="480" maxWidth="400" minHeight="480" prefHeight="480.0" prefWidth="400.0" spacing="22" 
        style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 8);" 
        StackPane.alignment="CENTER">
        <padding>
            <Insets bottom="35" left="45" right="45" top="35" />
        </padding>

        <!-- Title with Icon -->
        <Label style="-fx-font-family: 'Segoe UI', 'Poppins'; -fx-font-weight: 700; -fx-font-size: 26; -fx-text-fill: #690000;" text="🔐 تسجيل الدخول" />
        <Label style="-fx-font-family: 'Segoe UI', 'Poppins'; -fx-font-weight: 400; -fx-font-size: 16; -fx-text-fill: #666;" text="أهلاً بك في نظام النوران" />

        <!-- Fields -->
        <GridPane hgap="10" nodeOrientation="RIGHT_TO_LEFT" vgap="16">
            <columnConstraints>
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>

            <!-- Username -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 600; -fx-font-size: 14; -fx-text-fill: #444; -fx-alignment: CENTER-RIGHT;" text="📧 البريد الالكتروني" GridPane.rowIndex="0" />

            <TextField fx:id="usernameField" nodeOrientation="LEFT_TO_RIGHT" prefHeight="42.0" prefWidth="300.0" promptText="example@email.com" 
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 12; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 12; -fx-padding: 10 15;" 
                GridPane.rowIndex="1" />

            <!-- Password -->
            <Label style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 600; -fx-font-size: 14; -fx-text-fill: #444; -fx-alignment: CENTER-RIGHT;" text="🔑 كلمة المرور" GridPane.rowIndex="2" />

            <PasswordField fx:id="passwordField" nodeOrientation="LEFT_TO_RIGHT" prefHeight="42.0" promptText="••••••••" 
                style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14; -fx-background-radius: 12; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-radius: 12; -fx-padding: 10 15;" 
                GridPane.rowIndex="3" />
        </GridPane>

        <!-- Forgot Password -->
        <Hyperlink fx:id="forgotPasswordLink" nodeOrientation="RIGHT_TO_LEFT" onAction="#onForgotPasswordClicked" 
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13; -fx-text-fill: #888; -fx-underline: false;" text="نسيت كلمة المرور؟" />

        <!-- Login Button with Gradient -->
        <Button fx:id="loginButton" onAction="#onLoginClicked" prefWidth="220" prefHeight="48"
            style="-fx-font-family: 'Segoe UI'; -fx-font-weight: 700; -fx-font-size: 16; -fx-background-color: linear-gradient(to bottom, #8B0000, #690000); -fx-background-radius: 14; -fx-text-fill: white; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 3);" 
            text="تسجيل الدخول" />
    </VBox>

    <!-- Logo Section - Top Left -->
    <ImageView fitHeight="240.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="TOP_LEFT">
        <image>
            <Image url="@images/Logo.png" />
        </image>
        <StackPane.margin>
            <Insets top="-10" />
        </StackPane.margin>
    </ImageView>

</StackPane>


