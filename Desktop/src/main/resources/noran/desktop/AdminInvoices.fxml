<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="780" prefWidth="1250" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.AdminInvoicesController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>
    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>


    <center>
        <VBox spacing="30" style="-fx-padding: 30 40;">
         <AnchorPane prefHeight="200.0" prefWidth="200.0">
            <children>
               <Button fx:id="updateClientBtn2" onAction="#refresh" prefHeight="55.0" prefWidth="66.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" />
               <ImageView fitHeight="47.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@images/cached.png" />
                  </image>
               </ImageView>
               <Button fx:id="updateClientBtn1" layoutX="2.0" onAction="#refreshTable" prefHeight="55.0" prefWidth="66.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" />
            </children>
         </AnchorPane>
            <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" text="جميع الفواتير في النظام" />

            <!-- فلتر الحالة -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-font-size: 16;" text="فلتر الحالة:" />
                <ComboBox fx:id="statusFilter" prefWidth="200" promptText="جميع الحالات" style="-fx-background-radius: 10;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="الكل" />
                            <String fx:value="pending" />
                            <String fx:value="accepted" />
                            <String fx:value="rejected" />
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>

            <!-- الجدول -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                <TableView fx:id="adminInvoicesTable" prefHeight="580" prefWidth="1160" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colInvoiceNumber" prefWidth="180" text="رقم الفاتورة" />
                        <TableColumn fx:id="colClientName" prefWidth="280" text="اسم العميل" />
                        <TableColumn fx:id="colTotal" prefWidth="150" text="المجموع" />
                        <TableColumn fx:id="colDate" prefWidth="200" text="تاريخ الإنشاء" />
                        <TableColumn fx:id="colStatus" prefWidth="140" text="الحالة" />
                        <TableColumn fx:id="colActions" prefWidth="220" text="إجراءات" />
                    </columns>
                </TableView>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
