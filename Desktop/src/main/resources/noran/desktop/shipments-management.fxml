<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="780" prefWidth="1250" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ShipmentsManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>
    <right>
        <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="updateClientBtn1" layoutX="50.0" layoutY="30.0" onAction="#editShipment" prefHeight="55.0" prefWidth="66.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" />

                <ImageView fitHeight="284.0" fitWidth="548.0" layoutX="190.0" layoutY="-33.0" preserveRatio="true">
                    <image>
                        <Image url="@images/invoice-illustration.png" />
                    </image>
                </ImageView>

                <StackPane layoutX="6.0" layoutY="218.0" prefHeight="331.0" prefWidth="942.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;">
                    <children>
                        <TableView fx:id="clientTable" prefHeight="380.0" prefWidth="880.0" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">

                            <columns>
                                <TableColumn fx:id="colCustomerName" prefWidth="200" text="اسم العميل" />
                                <TableColumn fx:id="colAcid" prefWidth="150" text="ACID" />
                                <TableColumn fx:id="colPortName" prefWidth="150" text="اسم الميناء" />
                                <TableColumn fx:id="colCountry" prefWidth="150" text="الدولة" />
                                <TableColumn fx:id="colShipmentStatus" prefWidth="150" text="الحالة" />
                            </columns>
                        </TableView>
                    </children>
                </StackPane>

                <Button fx:id="updateClientBtn" layoutX="455.0" layoutY="578.0" onAction="#editShipment" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="تعديل الشحنة" />

                <Button fx:id="deleteClientBtn" layoutX="323.0" layoutY="576.0" onAction="#deleteShipment" prefHeight="44.0" prefWidth="119.0" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 8;" text="مسح الشحنة" textFill="WHITE">
                    <font>
                        <Font name="Arial Bold" size="12.0" />
                    </font>
                </Button>

                <Button layoutX="47.0" layoutY="34.0" onAction="#initialize" style="-fx-background-color: transparent;">
                    <graphic>
                        <ImageView fitHeight="47.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/cached.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </children>
        </AnchorPane>
    </right>
</BorderPane>