<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ShipmentsManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Header with refresh button and illustration -->
            <HBox alignment="CENTER_LEFT" spacing="200">
                <Button onAction="#refresh" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="47.0" fitWidth="61.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/cached.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
<!--                <Region prefHeight="166.0" prefWidth="10.0" HBox.hgrow="ALWAYS" />-->
                <ImageView fitHeight="200.0" fitWidth="350.0" preserveRatio="true">
                    <image>
                        <Image url="@images/invoice-illustration.png" />
                    </image>
                </ImageView>
            </HBox>

            <!-- Table Container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
                <TableView fx:id="clientTable" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colCustomerName" prefWidth="200" text="اسم العميل" />
                        <TableColumn fx:id="colAcid" prefWidth="150" text="ACID" />
                        <TableColumn fx:id="colPortName" prefWidth="150" text="اسم الميناء" />
                        <TableColumn fx:id="colCountry" prefWidth="150" text="الدولة" />
                        <TableColumn fx:id="colShipmentStatus" prefWidth="150" text="الحالة" />
                    </columns>
                </TableView>
            </StackPane>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Button fx:id="updateClientBtn" onAction="#editShipment" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="تعديل الشحنة" />
                <Button fx:id="deleteClientBtn" onAction="#deleteShipment" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="مسح الشحنة" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
