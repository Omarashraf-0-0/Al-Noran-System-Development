<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ShipmentsManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 28 24;">
            <!-- Header with illustration and refresh -->
            <AnchorPane prefHeight="180.0">
                <StackPane alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0">
                    <ImageView fitHeight="180.0" fitWidth="320.0" preserveRatio="true">
                        <image>
                            <Image url="@images/invoice-illustration.png" />
                        </image>
                    </ImageView>
                </StackPane>
                <Button onAction="#refresh" style="-fx-background-color: transparent; -fx-cursor: hand;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                    <graphic>
                        <ImageView fitHeight="44.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/cached.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </AnchorPane>

            <!-- Table Title -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 8;">
                <Label text="📦 شحنات الاستيراد" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333;" />
            </HBox>

            <!-- Table Container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);" VBox.vgrow="ALWAYS">
                <TableView fx:id="clientTable" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                    <columns>
                        <TableColumn fx:id="colCustomerName" prefWidth="180" text="اسم العميل" />
                        <TableColumn fx:id="colAcid" prefWidth="130" text="ACID" />
                        <TableColumn fx:id="colPortName" prefWidth="130" text="اسم الميناء" />
                        <TableColumn fx:id="colCountry" prefWidth="130" text="الدولة" />
                        <TableColumn fx:id="colShipmentStatus" prefWidth="130" text="الحالة" />
                        <TableColumn fx:id="colAssignedTo" prefWidth="150" text="مسند إلى" />
                    </columns>
                </TableView>
            </StackPane>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="16" style="-fx-padding: 8 0;">
                <Button fx:id="updateClientBtn" onAction="#editShipment" 
                    style="-fx-background-color: #1ba3b6; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 12; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3); -fx-cursor: hand;" 
                    text="✏️ تعديل الشحنة" />
                <Button fx:id="deleteClientBtn" onAction="#deleteShipment" 
                    style="-fx-background-color: linear-gradient(to bottom, #a40000, #690000); -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 12; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3); -fx-cursor: hand;" 
                    text="🗑️ مسح الشحنة" />
            </HBox>
        </VBox>
    </center>
</BorderPane>

