<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="780" prefWidth="1250" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.ShipmentsManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 32 24;">


            <ImageView fitHeight="220" preserveRatio="true">
                <image>
                    <Image url="@images/invoice-illustration.png" />
                </image>
            </ImageView>
            <!-- Table container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;">
                <TableView fx:id="clientTable" prefHeight="380" prefWidth="880" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">

                    <columns>
                        <TableColumn fx:id="colPortName" prefWidth="220" text="اسم الميناء" />
                        <TableColumn fx:id="colContainerNumber" prefWidth="220" text="عدد الحاويات" />
                        <TableColumn fx:id="colCounrty" prefWidth="220" text="الدولة" />
                        <TableColumn fx:id="colShipmentStatus" prefWidth="220" text="حالة الشحنة" />
                        <TableColumn fx:id="colPolicy" prefWidth="220" text="البوليصة" />
                    </columns>
                </TableView>
            </StackPane>
            <!-- Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 12 0 0 0;">

                <Button fx:id="deleteClientBtn" onAction="#deleteShipment" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 8;" text="مسح الشحنة" />

                <Button fx:id="updateClientBtn" onAction="#editShipment" style="-fx-background-color: #690000; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;" text="تعديل الشحنة" />

                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
