<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" 
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: linear-gradient(to bottom right, #f8f9fa, #eef1f5);" 
            stylesheets="@shipments.css"
            xmlns="http://javafx.com/javafx/17.0.12" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="noran.desktop.Controllers.ShipmentsManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 40;">
                
                <!-- Page Header -->
                <HBox alignment="CENTER" spacing="0">
                    <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <StackPane prefWidth="50" prefHeight="50">
                                <Circle radius="25" style="-fx-fill: linear-gradient(to bottom right, #a40000, #7a0000);"/>
                                <Label text="📦" style="-fx-font-size: 24px;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label text="إدارة شحنات الاستيراد" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;"/>
                                <Label text="عرض وإدارة جميع شحنات الاستيراد" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    
                    <!-- Refresh Button -->
                    <Button onAction="#refresh" styleClass="refresh-button">
                        <graphic>
                            <HBox alignment="CENTER" spacing="8">
                                <Label text="🔄" style="-fx-font-size: 18px;"/>
                                <Label text="تحديث" style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-weight: 700;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

                <!-- Stats Cards -->
                <HBox spacing="20">
                    <StackPane styleClass="mini-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_RIGHT" spacing="14">
                            <VBox alignment="CENTER_RIGHT" spacing="4">
                                <Label text="إجمالي الشحنات" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                                <Label fx:id="totalShipmentsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #a40000;"/>
                            </VBox>
                            <StackPane prefWidth="48" prefHeight="48">
                                <Circle radius="24" style="-fx-fill: linear-gradient(to bottom right, #a40000, #7a0000);"/>
                                <Label text="📦" style="-fx-font-size: 22px;"/>
                            </StackPane>
                        </HBox>
                    </StackPane>
                    
                    <StackPane styleClass="mini-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_RIGHT" spacing="14">
                            <VBox alignment="CENTER_RIGHT" spacing="4">
                                <Label text="قيد التنفيذ" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                                <Label fx:id="inProgressLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #D4AF37;"/>
                            </VBox>
                            <StackPane prefWidth="48" prefHeight="48">
                                <Circle radius="24" style="-fx-fill: linear-gradient(to bottom right, #D4AF37, #b8941f);"/>
                                <Label text="⏳" style="-fx-font-size: 22px;"/>
                            </StackPane>
                        </HBox>
                    </StackPane>
                    
                    <StackPane styleClass="mini-stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_RIGHT" spacing="14">
                            <VBox alignment="CENTER_RIGHT" spacing="4">
                                <Label text="مكتملة" style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                                <Label fx:id="completedLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #10b981;"/>
                            </VBox>
                            <StackPane prefWidth="48" prefHeight="48">
                                <Circle radius="24" style="-fx-fill: linear-gradient(to bottom right, #10b981, #059669);"/>
                                <Label text="✅" style="-fx-font-size: 22px;"/>
                            </StackPane>
                        </HBox>
                    </StackPane>
                </HBox>

                <!-- Table Section -->
                <VBox spacing="0" styleClass="table-container" VBox.vgrow="ALWAYS">
                    <!-- Table Header -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #a40000, #7a0000); -fx-background-radius: 16 16 0 0; -fx-padding: 16 24;">
                        <Label text="قائمة شحنات الاستيراد" style="-fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: white;"/>
                        <Label text="📋" style="-fx-font-size: 18px;"/>
                    </HBox>
                    
                    <!-- Table -->
                    <StackPane style="-fx-background-color: white; -fx-background-radius: 0 0 16 16; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                        <TableView fx:id="clientTable" style="-fx-background-color: transparent;" stylesheets="@invoices-table.css">
                            <columns>
                                <TableColumn fx:id="colCustomerName" text="اسم العميل" />
                                <TableColumn fx:id="colAcid" text="ACID" />
                                <TableColumn fx:id="colPortName" text="اسم الميناء" />
                                <TableColumn fx:id="colCountry" text="الدولة" />
                                <TableColumn fx:id="colShipmentStatus" text="الحالة" />
                            </columns>
                        </TableView>
                    </StackPane>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 8 0;">
                    <Button fx:id="updateClientBtn" onAction="#editShipment" styleClass="secondary-button">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="✏️" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
                                <Label text="تعديل الشحنة" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="deleteClientBtn" onAction="#deleteShipment" styleClass="danger-button">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🗑️" style="-fx-font-size: 16px; -fx-text-fill: white;"/>
                                <Label text="مسح الشحنة" style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>
                
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
