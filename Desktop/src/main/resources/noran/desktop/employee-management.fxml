<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT" style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui; -fx-background-color: linear-gradient(to bottom right, #f8f9fa, #eef1f5);" stylesheets="@shipments.css, @invoices-table.css, @combo-style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.EmployeeManagementController">

    <left>
        <fx:include fx:id="sidebar" source="Sidebar.fxml" />
    </left>

    <top>
        <fx:include fx:id="topBar" source="TopBar.fxml" />
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="24" style="-fx-padding: 32 40;">

            <!-- Page Header -->
            <HBox alignment="CENTER" spacing="0">
                <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <StackPane prefHeight="56" prefWidth="56">
                            <Circle radius="28" style="-fx-fill: linear-gradient(to bottom right, #a40000, #7a0000);" />
                            <Label style="-fx-font-size: 28px;-fx-text-fill: white" text="👨‍💼" />
                        </StackPane>
                        <VBox spacing="4">
                            <Label style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #1a1a2e;" text="إدارة الموظفين" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="قائمة الموظفين وبيانات الملف الشخصي" />
                        </VBox>
                    </HBox>
                </VBox>

                <Button onAction="#refresh" styleClass="refresh-button">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <Label style="-fx-font-size: 18px;-fx-text-fill: white" text="🔄" />
                            <Label style="-fx-font-size: 15px; -fx-text-fill: white; -fx-font-weight: 700;" text="تحديث" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>

            <!-- Filter Section -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 16 24; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
                <Label text="نوع الموظف:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;" />
                <ComboBox fx:id="employeeTypeFilter" prefWidth="150" promptText="الكل" />
                
                <Label text="حالة الموظف:" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555;" />
                <ComboBox fx:id="employeeStatusFilter" prefWidth="120" promptText="الكل" />
            </HBox>

            <!-- Table Container -->
            <VBox spacing="0" styleClass="table-container" VBox.vgrow="ALWAYS">
                <!-- Gradient Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to left, #a40000, #7a0000); -fx-background-radius: 16 16 0 0; -fx-padding: 18 28;">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: 600; -fx-text-fill: white;" text="قائمة الموظفين" />
                    <Label style="-fx-font-size: 18px;-fx-text-fill: white" text="📋" />
                </HBox>

                <!-- Table -->
                <StackPane style="-fx-background-color: white; -fx-background-radius: 0 0 16 16; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                    <TableView fx:id="clientTable" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colName" prefWidth="200" text="اسم الموظف" />
                            <TableColumn fx:id="colEmail" prefWidth="240" text="البريد الالكتروني" />
                            <TableColumn fx:id="colPhone" prefWidth="160" text="رقم الهاتف" />
                            <TableColumn fx:id="colType" prefWidth="180" text="نوع الموظف" />
                            <TableColumn fx:id="colRank" prefWidth="140" text="حالة الموظف" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </StackPane>
            </VBox>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 8 0;">
                <Button fx:id="addُEmployeebtn" onAction="#addُEmployee" styleClass="success-button">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="➕" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;" text="إضافة موظف جديد" />
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="updateClientBtn" onAction="#editEmployee" styleClass="secondary-button">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="✏️" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;" text="تعديل الموظف" />
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="freezeClientBtn" onAction="#freezeEmployee" styleClass="danger-button">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="❄️" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;" text="تجميد الموظف" />
                        </HBox>
                    </graphic>
                </Button>
                <Button fx:id="deleteClientBtn" onAction="#deleteEmployee" styleClass="danger-button">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size: 16px; -fx-text-fill: white;" text="🗑️" />
                            <Label style="-fx-font-size: 14px; -fx-text-fill: white; -fx-font-weight: 600;" text="مسح الموظف" />
                        </HBox>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
