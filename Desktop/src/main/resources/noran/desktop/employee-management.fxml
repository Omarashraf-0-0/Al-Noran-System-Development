<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane nodeOrientation="RIGHT_TO_LEFT"
            prefHeight="780"
            prefWidth="1250"
            style="-fx-font-family: 'Segoe UI', 'Noto Sans Arabic', system-ui;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="noran.desktop.Controllers.EmployeeManagementController">

    <left>
        <fx:include source="Sidebar.fxml" fx:id="sidebar" />
    </left>

    <top>
        <fx:include source="TopBar.fxml" fx:id="topBar"/>
    </top>
    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="24" alignment="TOP_CENTER" style="-fx-padding: 32 24;">


            <ImageView fitHeight="220" preserveRatio="true">
                <image>
                    <Image url="@images/invoice-illustration.png" />
                </image>
            </ImageView>
            <!-- Table container -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #eee; -fx-border-radius: 12;">
                <TableView fx:id="clientTable"
                           prefHeight="380"
                           prefWidth="880"
                           stylesheets="@invoices-table.css"
                           style="-fx-background-color: transparent;">

                    <columns>
                        <TableColumn fx:id="colName" text="اسم الموظف" prefWidth="220"/>
                        <TableColumn fx:id="colEmail" text="البريد الالكتروني" prefWidth="220"/>
                        <TableColumn fx:id="colPhone" text="رقم الهاتف" prefWidth="220"/>
                        <TableColumn fx:id="colType" text="نوع الموظف" prefWidth="220"/>
                        <TableColumn fx:id="colRank" text="حالة الموظف" prefWidth="220"/>
                    </columns>
                </TableView>
            </StackPane>
            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 12 0 0 0;">
                <Button fx:id="addُEmployeebtn"
                        onAction="#addُEmployee"
                        style="-fx-background-color: #c91e2b; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 8; -fx-font-weight: bold"
                        text="إضافة موظف جديد +" />

                <Button fx:id="deleteClientBtn"
                        onAction="#deleteEmployee"
                        style="-fx-background-color: #c91e2b; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 8; -fx-font-weight: bold"
                        text="مسح الموظف" />

                <Button fx:id="updateClientBtn"
                        onAction="#editEmployee"
                        style="-fx-background-color: #c91e2b; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;"
                        text="تعديل الموظف" />

<!--                <Region HBox.hgrow="ALWAYS" />-->
                <Button fx:id="freezeClientBtn"
                        onAction="#freezeEmployee"
                        style="-fx-background-color: #c91e2b; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-font-weight: bold;"
                        text="تجميد الموظف" />
            </HBox>
        </VBox>
    </center>
</BorderPane>