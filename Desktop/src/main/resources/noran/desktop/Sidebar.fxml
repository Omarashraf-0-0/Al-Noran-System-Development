<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<VBox fx:id="sidebar" alignment="TOP_CENTER" prefWidth="280" spacing="0" style="-fx-background-color: linear-gradient(to bottom, #a40000, #7a0000, #520000);" stylesheets="@sidebar.css" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="noran.desktop.Controllers.SidebarController">
    
    <!-- Logo Section -->
    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 16 20 10 20;">
        <ImageView fitHeight="80" fitWidth="80" preserveRatio="true" smooth="true">
            <effect>
                <DropShadow color="rgba(0,0,0,0.3)" radius="15" />
            </effect>
            <image>
                <Image url="@images/white-logo.png" />
            </image>
        </ImageView>
        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: white;" text="نظام النوران">
            <effect>
                <DropShadow color="rgba(0,0,0,0.2)" radius="5" />
            </effect>
        </Label>
        
        <!-- Decorative Line -->
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 12 0 0 0;">
            <Rectangle arcHeight="2" arcWidth="2" fill="rgba(212,175,55,0.7)" height="2" width="30" />
            <Circle fill="rgba(212,175,55,0.7)" radius="3" />
            <Rectangle arcHeight="2" arcWidth="2" fill="rgba(212,175,55,0.7)" height="2" width="30" />
        </HBox>
    </VBox>

    <!-- Navigation Section -->
    <VBox alignment="CENTER_LEFT" nodeOrientation="RIGHT_TO_LEFT" spacing="4" style="-fx-padding: 8 16 8 16;" VBox.vgrow="ALWAYS">
        
        <!-- Dashboard -->
        <Button fx:id="dashboardBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToDashboard" styleClass="sidebar-button" text="📊  لوحة التحكم" />
        
        <!-- Invoice Completion -->
        <Button fx:id="invoiceCompletionBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToTa5lees" styleClass="sidebar-button" text="📋  تخليص الفواتير" />

        <!-- Accepted Invoices -->
        <Button fx:id="acceptedInvoicesBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToAcceptedInvoices" styleClass="sidebar-button" text="✅  الفواتير المقبولة" />

        <!-- Invoices Management -->
        <Button fx:id="invoicesBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToInvoices" styleClass="sidebar-button" text="📄  إدارة الفواتير" />

        <!-- Add New Invoice -->
        <Button fx:id="addInvoicesBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToAddInvoices" styleClass="sidebar-button" text="➕  اضافه فاتورة جديدة" />
   
        <!-- Clients Management -->
        <Button fx:id="clientsBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToClients" styleClass="sidebar-button" text="👥  إدارة العملاء" />

        <!-- Employee Management -->
        <Button fx:id="employeesBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToEmployees" styleClass="sidebar-button" text="🔐  إدارة الموظفين" />
        
        <!-- Import Shipments -->
        <Button fx:id="shipmentsBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#shipments_management" styleClass="sidebar-button" text="📦  إدارة شحنات الاستيراد" />
        
        <!-- Export Shipments -->
        <Button fx:id="exportShipmentsBtn" contentDisplay="RIGHT" maxWidth="Infinity" nodeOrientation="LEFT_TO_RIGHT" onAction="#navigateToExportShipments" styleClass="sidebar-button" text="📤  إدارة شحنات التصدير" />
        
        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS" />
        
    </VBox>
    
    <!-- Bottom Section -->
    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 16 16 24 16; -fx-background-color: rgba(0,0,0,0.15);">
        <HBox alignment="CENTER" spacing="10">
            <Rectangle fill="rgba(255,255,255,0.2)" height="1" width="60" />
        </HBox>
        <Label style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.5);" text="© 2024 Al-Noran System" />
    </VBox>
</VBox>
